# NinjaRMM Deployment Script for USB Device Monitor
# This script:
# 1. Creates the installation directory
# 2. Deploys the USB monitoring script
# 3. Creates a scheduled task to run it permanently at startup
# 4. Starts the monitoring immediately

#Requires -RunAsAdministrator

Write-Host "========================================" -ForegroundColor Cyan
Write-Host "USB Monitor Deployment Script" -ForegroundColor Cyan
Write-Host "========================================" -ForegroundColor Cyan
Write-Host ""

# Configuration
$installPath = "C:\ProgramData\USBMonitor"
$scriptName = "usb_monitor.ps1"
$taskName = "USB Device Monitor"

# Step 1: Create installation directory
Write-Host "[1/5] Creating installation directory..." -ForegroundColor Yellow
if (-not (Test-Path $installPath)) {
    New-Item -Path $installPath -ItemType Directory -Force | Out-Null
    Write-Host "✓ Created: $installPath" -ForegroundColor Green
} else {
    Write-Host "✓ Directory already exists: $installPath" -ForegroundColor Green
}

# Step 2: Deploy the USB monitoring script
Write-Host "[2/5] Deploying USB monitoring script..." -ForegroundColor Yellow

$scriptContent = @'
# USB Device Monitor and Restart Script for Windows
# Automatically restarts newly plugged-in USB devices

# Check if running as Administrator
$isAdmin = ([Security.Principal.WindowsPrincipal] [Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)

if (-not $isAdmin) {
    Write-Host "ERROR: This script must be run as Administrator!" -ForegroundColor Red
    exit
}

# Set up logging
$logFile = Join-Path $PSScriptRoot "usb_monitor.log"

function Write-Log {
    param([string]$Message, [string]$Level = "INFO")
    
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logMessage = "$timestamp - $Level - $Message"
    
    Add-Content -Path $logFile -Value $logMessage -ErrorAction SilentlyContinue
}

function Restart-UsbDevice {
    param([string]$DeviceId)
    
    Write-Log "Starting restart for device: $DeviceId" "INFO"
    
    try {
        # Get device info
        $device = Get-PnpDevice | Where-Object { $_.InstanceId -eq $DeviceId }
        
        if ($device) {
            Write-Log "Device Name: $($device.FriendlyName)" "INFO"
            Write-Log "Initial Status: $($device.Status)" "INFO"
            
            # Disable device
            Write-Log "Disabling device..." "INFO"
            Disable-PnpDevice -InstanceId $DeviceId -Confirm:$false -ErrorAction Stop
            Write-Log "Device disabled" "SUCCESS"
            
            Start-Sleep -Seconds 1
            
            # Enable device
            Write-Log "Enabling device..." "INFO"
            Enable-PnpDevice -InstanceId $DeviceId -Confirm:$false -ErrorAction Stop
            Write-Log "Device enabled" "SUCCESS"
            
            Start-Sleep -Seconds 2
            
            # Verify
            $finalDevice = Get-PnpDevice | Where-Object { $_.InstanceId -eq $DeviceId }
            Write-Log "Final Status: $($finalDevice.Status)" "INFO"
            
            if ($finalDevice.Status -eq "OK") {
                Write-Log "VERIFICATION PASSED: Device successfully restarted" "SUCCESS"
                return $true
            } else {
                Write-Log "VERIFICATION FAILED: Device may not have restarted" "WARNING"
                return $false
            }
        } else {
            Write-Log "Device not found" "ERROR"
            return $false
        }
    }
    catch {
        Write-Log "Error during restart: $_" "ERROR"
        return $false
    }
}

# Main monitoring loop
Write-Log "Script started" "INFO"
Write-Log "Running with Administrator privileges" "SUCCESS"

# Get baseline of currently connected devices (don't restart these!)
Write-Log "Getting baseline of currently connected devices..." "INFO"
$knownDevices = @{}
$baselineDevices = Get-PnpDevice -Class USB | Where-Object { $_.Status -eq "OK" }
foreach ($device in $baselineDevices) {
    $knownDevices[$device.InstanceId] = $true
    Write-Log "Baseline device: $($device.FriendlyName)" "INFO"
}

Write-Log "Monitoring for NEW USB devices only..." "INFO"

try {
    # Monitor for NEW USB device connections only
    while ($true) {
        # Get current USB devices (create array to avoid enumeration issues)
        $currentDevices = @(Get-PnpDevice -Class USB | Where-Object { $_.Status -eq "OK" })
        
        # Process each device
        foreach ($device in $currentDevices) {
            $deviceId = $device.InstanceId
            
            # Check if this is a NEW device (not in baseline)
            if (-not $knownDevices.ContainsKey($deviceId)) {
                Write-Log "NEW USB DEVICE DETECTED: $($device.FriendlyName)" "INFO"
                
                # Add to known devices FIRST (to prevent multiple restarts)
                $knownDevices[$deviceId] = $true
                
                # Small delay to let device fully initialize
                Start-Sleep -Milliseconds 500
                
                # Restart the NEW device
                $success = Restart-UsbDevice -DeviceId $deviceId
                
                if ($success) {
                    Write-Log "Device restart completed successfully" "SUCCESS"
                } else {
                    Write-Log "Device restart may have failed" "ERROR"
                }
            }
        }
        
        # Clean up disconnected devices from known list (create copy of keys)
        $currentIds = @($currentDevices | ForEach-Object { $_.InstanceId })
        $keysToRemove = @($knownDevices.Keys | Where-Object { $_ -notin $currentIds })
        
        foreach ($key in $keysToRemove) {
            $knownDevices.Remove($key)
        }
        
        Start-Sleep -Milliseconds 500
    }
}
catch {
    Write-Log "Error in monitoring loop: $_" "ERROR"
}
finally {
    Write-Log "Script stopped" "INFO"
}
'@

# Write the script to the installation directory
$scriptPath = Join-Path $installPath $scriptName
Set-Content -Path $scriptPath -Value $scriptContent -Force
Write-Host "✓ Script deployed to: $scriptPath" -ForegroundColor Green

# Step 3: Remove existing scheduled task if it exists
Write-Host "[3/5] Checking for existing scheduled task..." -ForegroundColor Yellow
$existingTask = Get-ScheduledTask -TaskName $taskName -ErrorAction SilentlyContinue
if ($existingTask) {
    Unregister-ScheduledTask -TaskName $taskName -Confirm:$false
    Write-Host "✓ Removed existing task" -ForegroundColor Green
} else {
    Write-Host "✓ No existing task found" -ForegroundColor Green
}

# Step 4: Create scheduled task to run at startup
Write-Host "[4/5] Creating scheduled task..." -ForegroundColor Yellow

$action = New-ScheduledTaskAction -Execute "powershell.exe" -Argument "-ExecutionPolicy Bypass -WindowStyle Hidden -File `"$scriptPath`""
$trigger = New-ScheduledTaskTrigger -AtStartup
$principal = New-ScheduledTaskPrincipal -UserId "SYSTEM" -LogonType ServiceAccount -RunLevel Highest
$settings = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -StartWhenAvailable -RestartCount 3 -RestartInterval (New-TimeSpan -Minutes 1)

Register-ScheduledTask -TaskName $taskName -Action $action -Trigger $trigger -Principal $principal -Settings $settings -Description "Monitors and restarts newly connected USB devices" | Out-Null

Write-Host "✓ Scheduled task created: $taskName" -ForegroundColor Green

# Step 5: Start the monitoring immediately
Write-Host "[5/5] Starting USB monitoring..." -ForegroundColor Yellow

# Start the scheduled task now (don't wait for reboot)
Start-ScheduledTask -TaskName $taskName

# Wait a moment and check if it's running
Start-Sleep -Seconds 2
$taskInfo = Get-ScheduledTask -TaskName $taskName
$taskState = $taskInfo.State

if ($taskState -eq "Running") {
    Write-Host "✓ USB Monitor is now running" -ForegroundColor Green
} else {
    Write-Host "⚠ Task created but may not be running. State: $taskState" -ForegroundColor Yellow
    Write-Host "  It will start automatically on next reboot" -ForegroundColor Yellow
}

# Display summary
Write-Host ""
Write-Host "========================================" -ForegroundColor Cyan
Write-Host "Deployment Complete!" -ForegroundColor Green
Write-Host "========================================" -ForegroundColor Cyan
Write-Host ""
Write-Host "Installation Path: $installPath" -ForegroundColor White
Write-Host "Log File: $installPath\usb_monitor.log" -ForegroundColor White
Write-Host "Task Name: $taskName" -ForegroundColor White
Write-Host "Status: Running at startup (SYSTEM account)" -ForegroundColor White
Write-Host ""
Write-Host "The USB monitor will:" -ForegroundColor Yellow
Write-Host "  • Run automatically at system startup" -ForegroundColor White
Write-Host "  • Restart only newly plugged-in USB devices" -ForegroundColor White
Write-Host "  • Ignore existing USB devices (mouse, keyboard, etc.)" -ForegroundColor White
Write-Host "  • Log all activity to usb_monitor.log" -ForegroundColor White
Write-Host ""
Write-Host "To view logs, run:" -ForegroundColor Yellow
Write-Host "  Get-Content '$installPath\usb_monitor.log' -Tail 50" -ForegroundColor Cyan
Write-Host ""
Write-Host "To stop the monitor, run:" -ForegroundColor Yellow
Write-Host "  Stop-ScheduledTask -TaskName '$taskName'" -ForegroundColor Cyan
Write-Host ""
Write-Host "To uninstall, run:" -ForegroundColor Yellow
Write-Host "  Unregister-ScheduledTask -TaskName '$taskName' -Confirm:`$false" -ForegroundColor Cyan
Write-Host "  Remove-Item '$installPath' -Recurse -Force" -ForegroundColor Cyan
Write-Host ""
